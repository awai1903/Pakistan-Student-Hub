rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email in ['awais02sultan@gmail.com', 'awais01sultan@gmail.com'] ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Test connection document for connection health checks
    match /test/connection {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public educational registries: Read allowed for all users
    match /universities/{universityId} {
      allow read: if isValidId(universityId);
      allow write: if isAdmin();
    }

    match /admissions/{admissionId} {
      allow read: if isValidId(admissionId);
      allow write: if isAdmin();
    }

    match /scholarships/{scholarshipId} {
      allow read: if isValidId(scholarshipId);
      allow write: if isAdmin();
    }

    match /entry_tests/{testId} {
      allow read: if isValidId(testId);
      allow write: if isAdmin();
    }

    match /resources/{resourceId} {
      allow read: if isValidId(resourceId);
      allow write: if isAdmin();
    }

    match /jobs/{jobId} {
      allow read: if isValidId(jobId);
      allow write: if isAdmin();
    }

    match /internships/{internshipId} {
      allow read: if isValidId(internshipId);
      allow write: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if isValidId(courseId);
      allow write: if isAdmin();
    }

    match /news/{newsId} {
      allow read: if isValidId(newsId);
      allow write: if isAdmin();
    }

    // User Private Profile & Subcollections: Strictly Owner-isolated
    match /users/{userId} {
      allow read, write: if isOwner(userId) && isValidId(userId);

      match /saved_items/{itemId} {
        allow read, write: if isOwner(userId) && isValidId(itemId);
      }

      match /deadline_reminders/{reminderId} {
        allow read, write: if isOwner(userId) && isValidId(reminderId);
      }
    }
  }
}
