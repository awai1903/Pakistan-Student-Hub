rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email in ['awaissultan1903@gmail.com', 'awais05sultan@gmail.com', 'awais02sultan@gmail.com', 'awais01sultan@gmail.com'] ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Test connection document for connection health checks
    match /test/connection {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    // Public educational registries: Read allowed for all users
    match /universities/{universityId} {
      allow get: if isValidId(universityId);
      allow list: if true;
      allow write: if isAdmin();
    }

    match /admissions/{admissionId} {
      allow get: if isValidId(admissionId);
      allow list: if true;
      allow write: if isAdmin();
    }

    match /scholarships/{scholarshipId} {
      allow get: if isValidId(scholarshipId);
      allow list: if true;
      allow write: if isAdmin();
    }

    match /entry_tests/{testId} {
      allow get: if isValidId(testId);
      allow list: if true;
      allow write: if isAdmin();
    }

    match /resources/{resourceId} {
      allow get: if isValidId(resourceId);
      allow list: if true;
      allow write: if isAdmin();
    }

    match /jobs/{jobId} {
      allow get: if isValidId(jobId);
      allow list: if true;
      allow write: if isAdmin();
    }

    match /internships/{internshipId} {
      allow get: if isValidId(internshipId);
      allow list: if true;
      allow write: if isAdmin();
    }

    match /courses/{courseId} {
      allow get: if isValidId(courseId);
      allow list: if true;
      allow write: if isAdmin();
    }

    match /news/{newsId} {
      allow get: if isValidId(newsId);
      allow list: if true;
      allow write: if isAdmin();
    }

    // Public Community Reviews, Feature Requests & Student Feedback
    match /feedback/{feedbackId} {
      allow get: if isValidId(feedbackId);
      allow list: if true;
      allow create: if isValidId(feedbackId) &&
        incoming().title is string && incoming().title.size() > 0 && incoming().title.size() <= 200 &&
        incoming().content is string && incoming().content.size() > 0 && incoming().content.size() <= 2000 &&
        incoming().author_name is string && incoming().author_name.size() > 0 && incoming().author_name.size() <= 100 &&
        incoming().status in ['Under Review', 'Planned', 'In Progress', 'Completed', 'Published'] &&
        incoming().type in ['feature_request', 'university_suggestion', 'scholarship_request', 'general_review', 'bug_report'] &&
        (!('upvotes' in incoming()) || incoming().upvotes is number);
      allow update: if isAdmin() || (
        incoming().diff(existing()).affectedKeys().hasOnly(['upvotes']) &&
        incoming().upvotes == existing().upvotes + 1
      );
      allow delete: if isAdmin();
    }

    // User Private Profile & Subcollections: Strictly Owner-isolated
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow write: if isOwner(userId) && isValidId(userId);

      match /saved_items/{itemId} {
        allow get: if isOwner(userId) && isValidId(itemId);
        allow list: if isOwner(userId);
        allow write: if isOwner(userId) && isValidId(itemId);
      }

      match /deadline_reminders/{reminderId} {
        allow get: if isOwner(userId) && isValidId(reminderId);
        allow list: if isOwner(userId);
        allow write: if isOwner(userId) && isValidId(reminderId);
      }
    }
  }
}
