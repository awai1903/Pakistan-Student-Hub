{
  "entities": {
    "University": {
      "title": "University",
      "description": "HEC recognized Pakistani higher education institutions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 200 },
        "slug": { "type": "string", "maxLength": 100 },
        "short_name": { "type": "string", "maxLength": 50 },
        "city": { "type": "string", "maxLength": 100 },
        "province": { "type": "string", "maxLength": 100 },
        "sector": { "type": "string", "enum": ["Public", "Private", "Semi-Government"] },
        "website": { "type": "string", "maxLength": 500 },
        "established_year": { "type": "number" },
        "recognition_status": { "type": "string", "maxLength": 200 },
        "verification_status": { "type": "string", "enum": ["Draft", "Research", "Source Added", "Verified", "Published", "Needs Review", "Expired", "Archived"] }
      },
      "required": ["id", "name", "slug", "city", "province", "sector", "website", "verification_status"]
    },
    "Admission": {
      "title": "Admission",
      "description": "Verified university admission sessions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "university_id": { "type": "string" },
        "university_name": { "type": "string", "maxLength": 200 },
        "program_name": { "type": "string", "maxLength": 200 },
        "campus": { "type": "string", "maxLength": 100 },
        "admission_type": { "type": "string", "maxLength": 100 },
        "closing_date": { "type": "string", "maxLength": 20 },
        "status": { "type": "string", "enum": ["Upcoming", "Open", "Closing Soon", "Closed", "Archived"] },
        "verification_status": { "type": "string", "enum": ["Verified", "Published"] }
      },
      "required": ["id", "university_id", "program_name", "closing_date", "status", "verification_status"]
    },
    "Scholarship": {
      "title": "Scholarship",
      "description": "Verified student scholarships and financial assistance programs",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 250 },
        "slug": { "type": "string", "maxLength": 150 },
        "provider": { "type": "string", "maxLength": 200 },
        "funding_type": { "type": "string", "maxLength": 100 },
        "deadline": { "type": "string", "maxLength": 20 },
        "verification_status": { "type": "string", "enum": ["Verified", "Published"] }
      },
      "required": ["id", "title", "slug", "provider", "funding_type", "deadline", "verification_status"]
    },
    "EntryTest": {
      "title": "EntryTest",
      "description": "Standardized Pakistani entry tests (MDCAT, ECAT, NET, NAT)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "test_name": { "type": "string", "maxLength": 150 },
        "organizer": { "type": "string", "maxLength": 150 },
        "next_test_date": { "type": "string", "maxLength": 30 },
        "registration_deadline": { "type": "string", "maxLength": 30 },
        "verification_status": { "type": "string", "enum": ["Verified", "Published"] }
      },
      "required": ["id", "test_name", "organizer", "verification_status"]
    },
    "UserSavedItem": {
      "title": "UserSavedItem",
      "description": "Personal bookmarked admissions, universities, or scholarships",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user_id": { "type": "string" },
        "item_type": { "type": "string", "enum": ["university", "admission", "scholarship", "internship", "job"] },
        "item_id": { "type": "string", "maxLength": 100 },
        "title": { "type": "string", "maxLength": 250 },
        "subtitle": { "type": "string", "maxLength": 250 },
        "deadline": { "type": "string", "maxLength": 50 },
        "saved_at": { "type": "string" }
      },
      "required": ["id", "user_id", "item_type", "item_id", "title"]
    },
    "UserDeadlineReminder": {
      "title": "UserDeadlineReminder",
      "description": "Custom deadline countdown notifications set by student",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user_id": { "type": "string" },
        "title": { "type": "string", "maxLength": 250 },
        "deadline_date": { "type": "string", "maxLength": 50 },
        "category": { "type": "string", "maxLength": 50 },
        "link_url": { "type": "string", "maxLength": 500 },
        "notes": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "user_id", "title", "deadline_date", "category"]
    }
  },
  "firestore": {
    "/universities/{universityId}": {
      "schema": "University",
      "description": "Public catalog of verified universities in Pakistan"
    },
    "/admissions/{admissionId}": {
      "schema": "Admission",
      "description": "Verified university admissions intake cycles"
    },
    "/scholarships/{scholarshipId}": {
      "schema": "Scholarship",
      "description": "Verified scholarships catalog"
    },
    "/entry_tests/{testId}": {
      "schema": "EntryTest",
      "description": "Standardized entry tests info"
    },
    "/users/{userId}/saved_items/{itemId}": {
      "schema": "UserSavedItem",
      "description": "User bookmarked institutions and opportunities"
    },
    "/users/{userId}/deadline_reminders/{reminderId}": {
      "schema": "UserDeadlineReminder",
      "description": "User custom deadline reminders"
    }
  }
}
